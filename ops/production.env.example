# Copy to /opt/sunhost/.env.production on EC2 and set unique credentials.
# Academic demo storage persists in a Docker volume. Never use real customer data.
DEMO_MODE=true
ADMIN_EMAIL=admin@sunhost.local
ADMIN_PASSWORD=
PASSWORD_PEPPER=
# For PostgreSQL instead: DEMO_MODE=false and configure DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sunhost_floripa
